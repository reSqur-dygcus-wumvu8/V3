{
  "productName": "OSINT Secrets",
  "version": "0.1.0",
  "description": "Application de gestion des secrets pour OSINT App",
  "authors": ["Votre Organisation"],
  "license": "Propriétaire",
  "copyright": "Copyright © 2024 Votre Organisation",
  "identifier": "com.yourorg.osint_secrets",
  
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "",
    "distDir": "../dist/secrets",
    "withGlobalTauri": false,
    
    "macOS": {
      "minimumSystemVersion": "10.13",
      "target": ["x86_64", "arm64"],
      "bundleIdentifier": "com.yourorg.osint_secrets",
      "entitlements": {
        "com.apple.security.app-sandbox": false,
        "com.apple.security.network.server": true,
        "com.apple.security.network.client": true
      },
      "hardenedRuntime": true,
      "gatekeeper": {
        "entitlements": {
          "com.apple.security.cs.allow-unsigned-executable-memory": true
        }
      }
    },
    
    "linux": {
      "target": ["x86_64", "arm64"],
      "appImage": true,
      "deb": true,
      "rpm": true
    },
    
    "windows": {
      "target": ["x86_64"],
      "nsis": true,
      "wix": true
    }
  },
  
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "execute": [
          "security",
          "sh",
          "bash"
        ],
        "open": false,
        "scope": []
      },
      "fs": {
        "all": false,
        "readText": [
          "$APPDATA/**",
          "$HOME/**"
        ],
        "readBinary": [
          "$APPDATA/**",
          "$HOME/**"
        ],
        "writeText": [
          "$APPDATA/**",
          "$HOME/**"
        ],
        "writeBinary": [
          "$APPDATA/**",
          "$HOME/**"
        ],
        "scope": []
      },
      "path": {
        "all": false,
        "scope": []
      },
      "clipboard": {
        "all": false
      },
      "dialog": {
        "all": true
      },
      "http": {
        "all": false
      },
      "globalShortcut": {
        "all": false
      },
      "notification": {
        "all": true
      },
      "os": {
        "all": false
      },
      "process": {
        "all": false
      },
      "window": {
        "all": true
      }
    },
    
    "updater": {
      "active": false
    },
    
    "bundle": {
      "active": true,
      "targets": ["all"],
      "identifier": "com.yourorg.osint_secrets",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [],
      "externalBinaries": [],
      
      "macOS": {
        "appCategoryType": "public.app-category.utilities",
        "entitlements": {
          "com.apple.security.app-sandbox": false
        },
        "frameworks": [],
        "libraries": []
      },
      
      "linux": {
        "category": "Utility",
        "desktop": {
          "Name": "OSINT Secrets",
          "Comment": "Gestion des secrets pour OSINT App",
          "Exec": "osint_secrets",
          "Icon": "osint_secrets",
          "Terminal": false,
          "Type": "Application",
          "Categories": "Utility;",
          "StartupWMClass": "OSINT Secrets"
        }
      },
      
      "windows": {
        "appx": false,
        "msi": true,
        "nsis": true,
        "wix": true
      }
    }
  },
  
  "app": {
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data:; style-src 'self' 'unsafe-inline' data:; script-src 'self' 'unsafe-inline' 'unsafe-eval' data:; img-src 'self' data: blob:; connect-src 'none'; font-src 'self' data:; object-src 'none'; frame-src 'none';"
    },
    
    "windows": [
      {
        "title": "OSINT Secrets",
        "width": 600,
        "height": 400,
        "minWidth": 600,
        "minHeight": 400,
        "visible": true,
        "resizable": true,
        "decorations": true,
        "center": true,
        "url": "index.html"
      }
    ],
    
    "macOS": {
      "LSUIElement": false,
      "LSBackgroundOnly": false,
      "LSSupportsOpeningDocumentsInPlace": false,
      "NSHighResolutionCapable": true,
      "NSRequiresAquaSystemAppearance": false,
      "NSFullScreenEnabled": false
    }
  }
}
